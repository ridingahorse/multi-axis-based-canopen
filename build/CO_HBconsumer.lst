 126:CANopen/301/CO_ODinterface.h ****  *
 127:CANopen/301/CO_ODinterface.h ****  * @ref OD_getSDOabCode() can be used to retrieve corresponding SDO abort code.
 128:CANopen/301/CO_ODinterface.h ****  */
 129:CANopen/301/CO_ODinterface.h **** typedef enum {
 130:CANopen/301/CO_ODinterface.h ****     /* !!!! WARNING !!!! If changing these values, change also OD_getSDOabCode() function! */
 131:CANopen/301/CO_ODinterface.h ****     ODR_PARTIAL = -1,        /**< Read/write is only partial, make more calls */
 132:CANopen/301/CO_ODinterface.h ****     ODR_OK = 0,              /**< SDO abort 0x00000000 - Read/write successfully finished */
 133:CANopen/301/CO_ODinterface.h ****     ODR_OUT_OF_MEM = 1,      /**< SDO abort 0x05040005 - Out of memory */
 134:CANopen/301/CO_ODinterface.h ****     ODR_UNSUPP_ACCESS = 2,   /**< SDO abort 0x06010000 - Unsupported access to an object */
 135:CANopen/301/CO_ODinterface.h ****     ODR_WRITEONLY = 3,       /**< SDO abort 0x06010001 - Attempt to read a write only object */
 136:CANopen/301/CO_ODinterface.h ****     ODR_READONLY = 4,        /**< SDO abort 0x06010002 - Attempt to write a read only object */
 137:CANopen/301/CO_ODinterface.h ****     ODR_IDX_NOT_EXIST = 5,   /**< SDO abort 0x06020000 - Object does not exist in the object dict. 
