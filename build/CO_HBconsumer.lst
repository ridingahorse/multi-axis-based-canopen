 112:CANopen/301/CO_ODinterface.h ****     ODA_SDO_RW = 0x03U, /**< SDO server may read from or write to the variable */
 113:CANopen/301/CO_ODinterface.h ****     ODA_TPDO = 0x04U,   /**< Variable is mappable into TPDO (can be read) */
 114:CANopen/301/CO_ODinterface.h ****     ODA_RPDO = 0x08U,   /**< Variable is mappable into RPDO (can be written) */
 115:CANopen/301/CO_ODinterface.h ****     ODA_TRPDO = 0x0CU,  /**< Variable is mappable into TPDO or RPDO */
 116:CANopen/301/CO_ODinterface.h ****     ODA_TSRDO = 0x10U,  /**< Variable is mappable into transmitting SRDO */
 117:CANopen/301/CO_ODinterface.h ****     ODA_RSRDO = 0x20U,  /**< Variable is mappable into receiving SRDO */
 118:CANopen/301/CO_ODinterface.h ****     ODA_TRSRDO = 0x30U, /**< Variable is mappable into tx or rx SRDO */
 119:CANopen/301/CO_ODinterface.h ****     ODA_MB = 0x40U,     /**< Variable is multi-byte ((u)int16_t to (u)int64_t) */
 120:CANopen/301/CO_ODinterface.h ****     ODA_STR = 0x80U     /**< Shorter value, than specified variable size, may be written to the var
