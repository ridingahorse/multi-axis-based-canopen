  24:CANopen/301/CO_ODinterface.c **** ODR_t
  25:CANopen/301/CO_ODinterface.c **** OD_readOriginal(OD_stream_t* stream, void* buf, OD_size_t count, OD_size_t* countRead) {
  26:CANopen/301/CO_ODinterface.c ****     if ((stream == NULL) || (buf == NULL) || (countRead == NULL)) {
  27:CANopen/301/CO_ODinterface.c ****         return ODR_DEV_INCOMPAT;
  28:CANopen/301/CO_ODinterface.c ****     }
  29:CANopen/301/CO_ODinterface.c **** 
  30:CANopen/301/CO_ODinterface.c ****     OD_size_t dataLenToCopy = stream->dataLength; /* length of OD variable */
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\cc5II2LI.s 			page 2


  31:CANopen/301/CO_ODinterface.c ****     const uint8_t* dataOrig = stream->dataOrig;
  32:CANopen/301/CO_ODinterface.c **** 
  33:CANopen/301/CO_ODinterface.c ****     if (dataOrig == NULL) {
  34:CANopen/301/CO_ODinterface.c ****         return ODR_SUB_NOT_EXIST;
  35:CANopen/301/CO_ODinterface.c ****     }
  36:CANopen/301/CO_ODinterface.c **** 
  37:CANopen/301/CO_ODinterface.c ****     ODR_t returnCode = ODR_OK;
  38:CANopen/301/CO_ODinterface.c **** 
  39:CANopen/301/CO_ODinterface.c ****     /* If previous read was partial or OD variable length is larger than
  40:CANopen/301/CO_ODinterface.c ****      * current buffer size, then data was (will be) read in several segments */
  41:CANopen/301/CO_ODinterface.c ****     if ((stream->dataOffset > 0U) || (dataLenToCopy > count)) {
  42:CANopen/301/CO_ODinterface.c ****         if (stream->dataOffset >= dataLenToCopy) {
  43:CANopen/301/CO_ODinterface.c ****             return ODR_DEV_INCOMPAT;
  44:CANopen/301/CO_ODinterface.c ****         }
  45:CANopen/301/CO_ODinterface.c ****         /* Reduce for already copied data */
  46:CANopen/301/CO_ODinterface.c ****         dataLenToCopy -= stream->dataOffset;
  47:CANopen/301/CO_ODinterface.c ****         dataOrig += stream->dataOffset;
  48:CANopen/301/CO_ODinterface.c **** 
  49:CANopen/301/CO_ODinterface.c ****         if (dataLenToCopy > count) {
  50:CANopen/301/CO_ODinterface.c ****             /* Not enough space in destination buffer */
  51:CANopen/301/CO_ODinterface.c ****             dataLenToCopy = count;
  52:CANopen/301/CO_ODinterface.c ****             stream->dataOffset += dataLenToCopy;
  53:CANopen/301/CO_ODinterface.c ****             returnCode = ODR_PARTIAL;
  54:CANopen/301/CO_ODinterface.c ****         } else {
  55:CANopen/301/CO_ODinterface.c ****             stream->dataOffset = 0; /* copy finished, reset offset */
  56:CANopen/301/CO_ODinterface.c ****         }
  57:CANopen/301/CO_ODinterface.c ****     }
  58:CANopen/301/CO_ODinterface.c **** 
  59:CANopen/301/CO_ODinterface.c ****     (void)memcpy((void*)buf, (const void*)dataOrig, dataLenToCopy);
  60:CANopen/301/CO_ODinterface.c **** 
  61:CANopen/301/CO_ODinterface.c ****     *countRead = dataLenToCopy;
  62:CANopen/301/CO_ODinterface.c ****     return returnCode;
  63:CANopen/301/CO_ODinterface.c **** }
  64:CANopen/301/CO_ODinterface.c **** 
  65:CANopen/301/CO_ODinterface.c **** ODR_t
  66:CANopen/301/CO_ODinterface.c **** OD_writeOriginal(OD_stream_t* stream, const void* buf, OD_size_t count, OD_size_t* countWritten) {
  67:CANopen/301/CO_ODinterface.c ****     if ((stream == NULL) || (buf == NULL) || (countWritten == NULL)) {
  68:CANopen/301/CO_ODinterface.c ****         return ODR_DEV_INCOMPAT;
  69:CANopen/301/CO_ODinterface.c ****     }
  70:CANopen/301/CO_ODinterface.c **** 
  71:CANopen/301/CO_ODinterface.c ****     OD_size_t dataLenToCopy = stream->dataLength; /* length of OD variable */
  72:CANopen/301/CO_ODinterface.c ****     OD_size_t dataLenRemain = dataLenToCopy;      /* remaining length of dataOrig buffer */
  73:CANopen/301/CO_ODinterface.c ****     uint8_t* dataOrig = stream->dataOrig;
  74:CANopen/301/CO_ODinterface.c **** 
  75:CANopen/301/CO_ODinterface.c ****     if (dataOrig == NULL) {
  76:CANopen/301/CO_ODinterface.c ****         return ODR_SUB_NOT_EXIST;
  77:CANopen/301/CO_ODinterface.c ****     }
  78:CANopen/301/CO_ODinterface.c **** 
  79:CANopen/301/CO_ODinterface.c ****     ODR_t returnCode = ODR_OK;
  80:CANopen/301/CO_ODinterface.c **** 
  81:CANopen/301/CO_ODinterface.c ****     /* If previous write was partial or OD variable length is larger than current buffer size,
  82:CANopen/301/CO_ODinterface.c ****      * then data was (will be) written in several segments */
  83:CANopen/301/CO_ODinterface.c ****     if ((stream->dataOffset > 0U) || (dataLenToCopy > count)) {
  84:CANopen/301/CO_ODinterface.c ****         if (stream->dataOffset >= dataLenToCopy) {
  85:CANopen/301/CO_ODinterface.c ****             return ODR_DEV_INCOMPAT;
  86:CANopen/301/CO_ODinterface.c ****         }
  87:CANopen/301/CO_ODinterface.c ****         /* reduce for already copied data */
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\cc5II2LI.s 			page 3


  88:CANopen/301/CO_ODinterface.c ****         dataLenToCopy -= stream->dataOffset;
  89:CANopen/301/CO_ODinterface.c ****         dataLenRemain = dataLenToCopy;
  90:CANopen/301/CO_ODinterface.c ****         dataOrig += stream->dataOffset;
  91:CANopen/301/CO_ODinterface.c **** 
  92:CANopen/301/CO_ODinterface.c ****         if (dataLenToCopy > count) {
  93:CANopen/301/CO_ODinterface.c ****             /* Remaining data space in OD variable is larger than current count
  94:CANopen/301/CO_ODinterface.c ****              * of data, so only current count of data will be copied */
  95:CANopen/301/CO_ODinterface.c ****             dataLenToCopy = count;
  96:CANopen/301/CO_ODinterface.c ****             stream->dataOffset += dataLenToCopy;
  97:CANopen/301/CO_ODinterface.c ****             returnCode = ODR_PARTIAL;
  98:CANopen/301/CO_ODinterface.c ****         } else {
  99:CANopen/301/CO_ODinterface.c ****             stream->dataOffset = 0; /* copy finished, reset offset */
 100:CANopen/301/CO_ODinterface.c ****         }
 101:CANopen/301/CO_ODinterface.c ****     }
 102:CANopen/301/CO_ODinterface.c **** 
 103:CANopen/301/CO_ODinterface.c ****     if (dataLenToCopy < count) {
 104:CANopen/301/CO_ODinterface.c ****         /* OD variable is smaller than current amount of data */
 105:CANopen/301/CO_ODinterface.c ****         return ODR_DATA_LONG;
 106:CANopen/301/CO_ODinterface.c ****     }
 107:CANopen/301/CO_ODinterface.c **** 
 108:CANopen/301/CO_ODinterface.c ****     /* additional check for Misra c compliance */
 109:CANopen/301/CO_ODinterface.c ****     if ((dataLenToCopy <= dataLenRemain) && (dataLenToCopy <= count)) {
 110:CANopen/301/CO_ODinterface.c ****         (void)memcpy((void*)dataOrig, (const void*)buf, dataLenToCopy);
 111:CANopen/301/CO_ODinterface.c ****     } else {
 112:CANopen/301/CO_ODinterface.c ****         return ODR_DEV_INCOMPAT;
 113:CANopen/301/CO_ODinterface.c ****     }
 114:CANopen/301/CO_ODinterface.c **** 
 115:CANopen/301/CO_ODinterface.c ****     *countWritten = dataLenToCopy;
 116:CANopen/301/CO_ODinterface.c ****     return returnCode;
 117:CANopen/301/CO_ODinterface.c **** }
