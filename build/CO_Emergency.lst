 220:CANopen/301/CO_Emergency.c **** static ODR_t
 221:CANopen/301/CO_Emergency.c **** OD_read_statusBits(OD_stream_t* stream, void* buf, OD_size_t count, OD_size_t* countRead) {
 222:CANopen/301/CO_Emergency.c ****     if ((stream == NULL) || (stream->subIndex != 0U) || (buf == NULL) || (countRead == NULL)) {
