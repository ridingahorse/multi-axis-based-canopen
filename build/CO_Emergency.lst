 237:CANopen/301/CO_Emergency.c ****     }
 238:CANopen/301/CO_Emergency.c **** 
 239:CANopen/301/CO_Emergency.c ****     (void)memcpy((void*)(buf), (const void*)(&em->errorStatusBits[0]), countReadLocal);
