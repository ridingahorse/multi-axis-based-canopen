 229:CANopen/301/CO_Emergency.c ****     OD_size_t countReadLocal = CO_CONFIG_EM_ERR_STATUS_BITS_COUNT / 8U;
 230:CANopen/301/CO_Emergency.c ****     if (countReadLocal > count) {
 231:CANopen/301/CO_Emergency.c ****         countReadLocal = count;
