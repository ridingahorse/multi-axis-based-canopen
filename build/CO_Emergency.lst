 272:CANopen/301/CO_Emergency.c **** /*
 273:CANopen/301/CO_Emergency.c ****  * Read received message from CAN module.
 274:CANopen/301/CO_Emergency.c ****  *
 275:CANopen/301/CO_Emergency.c ****  * Function will be called (by CAN receive interrupt) every time, when CAN message with correct ide
 276:CANopen/301/CO_Emergency.c ****  * will be received. For more information and description of parameters see file CO_driver.h.
 277:CANopen/301/CO_Emergency.c ****  */
 278:CANopen/301/CO_Emergency.c **** static void
 279:CANopen/301/CO_Emergency.c **** CO_EM_receive(void* object, void* msg) {
 280:CANopen/301/CO_Emergency.c ****     CO_EM_t* em = (CO_EM_t*)object;
 281:CANopen/301/CO_Emergency.c **** 
 282:CANopen/301/CO_Emergency.c ****     if ((em != NULL) && (em->pFunctSignalRx != NULL)) {
 283:CANopen/301/CO_Emergency.c ****         uint16_t ident = CO_CANrxMsg_readIdent(msg);
 284:CANopen/301/CO_Emergency.c **** 
 285:CANopen/301/CO_Emergency.c ****         /* ignore sync messages (necessary if sync object is not used) */
 286:CANopen/301/CO_Emergency.c ****         if (ident != 0x80U) {
 287:CANopen/301/CO_Emergency.c ****             const uint8_t* data = CO_CANrxMsg_readData(msg);
 288:CANopen/301/CO_Emergency.c ****             uint16_t errorCode;
 289:CANopen/301/CO_Emergency.c ****             uint32_t infoCode;
 290:CANopen/301/CO_Emergency.c **** 
 291:CANopen/301/CO_Emergency.c ****             (void)memcpy((void*)(&errorCode), (const void*)(&data[0]), sizeof(errorCode));
 292:CANopen/301/CO_Emergency.c ****             (void)memcpy((void*)(&infoCode), (const void*)(&data[4]), sizeof(infoCode));
 293:CANopen/301/CO_Emergency.c ****             em->pFunctSignalRx(ident, CO_SWAP_16(errorCode), data[2], data[3], CO_SWAP_32(infoCode)
 294:CANopen/301/CO_Emergency.c ****         }
 295:CANopen/301/CO_Emergency.c ****     }
 296:CANopen/301/CO_Emergency.c **** }
 297:CANopen/301/CO_Emergency.c **** #endif
