  76:CANopen/301/CO_PDO.c **** /*
  77:CANopen/301/CO_PDO.c ****  * Find mapped variable in Object Dictionary and configure entry in RPDO or TPDO
  78:CANopen/301/CO_PDO.c ****  *
  79:CANopen/301/CO_PDO.c ****  * @param PDO This object will be configured. If map is erroneous, then it will stay unchanged.
  80:CANopen/301/CO_PDO.c ****  * @param map PDO mapping parameter.
  81:CANopen/301/CO_PDO.c ****  * @param mapIndex from 0 to CO_PDO_MAX_MAPPED_ENTRIES
  82:CANopen/301/CO_PDO.c ****  * @param isRPDO True for RPDO and false for TPDO.
  83:CANopen/301/CO_PDO.c ****  * @param OD Object Dictionary.
  84:CANopen/301/CO_PDO.c ****  *
  85:CANopen/301/CO_PDO.c ****  * @return ODR_OK on success, otherwise error reason.
  86:CANopen/301/CO_PDO.c ****  */
  87:CANopen/301/CO_PDO.c **** static ODR_t
  88:CANopen/301/CO_PDO.c **** PDOconfigMap(CO_PDO_common_t* PDO, uint32_t map, uint8_t mapIndex, bool_t isRPDO, OD_t* OD) {
  89:CANopen/301/CO_PDO.c ****     uint16_t index = (uint16_t)(map >> 16);
  90:CANopen/301/CO_PDO.c ****     uint8_t subIndex = (uint8_t)(map >> 8);
  91:CANopen/301/CO_PDO.c ****     uint8_t mappedLengthBits = (uint8_t)map;
  92:CANopen/301/CO_PDO.c ****     uint8_t mappedLength = mappedLengthBits >> 3;
  93:CANopen/301/CO_PDO.c ****     OD_IO_t* OD_IO = &PDO->OD_IO[mapIndex];
  94:CANopen/301/CO_PDO.c **** 
  95:CANopen/301/CO_PDO.c ****     /* total PDO length can not be more than CO_PDO_MAX_SIZE bytes */
  96:CANopen/301/CO_PDO.c ****     if (mappedLength > CO_PDO_MAX_SIZE) {
  97:CANopen/301/CO_PDO.c ****         return ODR_MAP_LEN; /* PDO length exceeded */
  98:CANopen/301/CO_PDO.c ****     }
  99:CANopen/301/CO_PDO.c **** 
 100:CANopen/301/CO_PDO.c ****     /* is there a reference to the dummy entry */
 101:CANopen/301/CO_PDO.c ****     if ((index < 0x20U) && (subIndex == 0U)) {
 102:CANopen/301/CO_PDO.c ****         OD_stream_t* stream = &OD_IO->stream;
 103:CANopen/301/CO_PDO.c ****         (void)memset(stream, 0, sizeof(OD_stream_t));
 104:CANopen/301/CO_PDO.c ****         stream->dataLength = mappedLength;
 105:CANopen/301/CO_PDO.c ****         stream->dataOffset = mappedLength;
 106:CANopen/301/CO_PDO.c ****         OD_IO->read = OD_read_dummy;
 107:CANopen/301/CO_PDO.c ****         OD_IO->write = OD_write_dummy;
 108:CANopen/301/CO_PDO.c ****         return ODR_OK;
 109:CANopen/301/CO_PDO.c ****     }
 110:CANopen/301/CO_PDO.c **** 
 111:CANopen/301/CO_PDO.c ****     /* find entry in the Object Dictionary */
 112:CANopen/301/CO_PDO.c ****     OD_IO_t OD_IOcopy;
 113:CANopen/301/CO_PDO.c ****     OD_entry_t* entry = OD_find(OD, index);
 114:CANopen/301/CO_PDO.c ****     ODR_t odRet = OD_getSub(entry, subIndex, &OD_IOcopy, false);
 115:CANopen/301/CO_PDO.c ****     if (odRet != ODR_OK) {
 116:CANopen/301/CO_PDO.c ****         return odRet;
 117:CANopen/301/CO_PDO.c ****     }
 118:CANopen/301/CO_PDO.c **** 
 119:CANopen/301/CO_PDO.c ****     /* verify access attributes, byte alignment and length */
 120:CANopen/301/CO_PDO.c ****     OD_attr_t testAttribute = isRPDO ? (OD_attr_t)(ODA_RPDO) : (OD_attr_t)(ODA_TPDO);
 121:CANopen/301/CO_PDO.c **** #if ((CO_CONFIG_PDO) & (CO_CONFIG_PDO_BITWISE_MAPPING)) != 0
 122:CANopen/301/CO_PDO.c ****     /* If the bitwise mapping is enabled, check only length in bits */
 123:CANopen/301/CO_PDO.c ****     if (((OD_IOcopy.stream.attribute & testAttribute) == 0U)
 124:CANopen/301/CO_PDO.c ****         || ((OD_IOcopy.stream.dataLength * 8) < mappedLengthBits)) {
 125:CANopen/301/CO_PDO.c **** #else
 126:CANopen/301/CO_PDO.c ****     /* If the bitwise mapping is disabled, theck the alignment and length in bytes*/
 127:CANopen/301/CO_PDO.c ****     if (((OD_IOcopy.stream.attribute & testAttribute) == 0U) || ((mappedLengthBits & 0x07U) != 0U)
 128:CANopen/301/CO_PDO.c ****         || (OD_IOcopy.stream.dataLength < mappedLength)) {
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccL1vOqM.s 			page 6


 129:CANopen/301/CO_PDO.c **** #endif /* (CO_CONFIG_PDO) & (CO_CONFIG_PDO_BITWISE_MAPPING) */
 130:CANopen/301/CO_PDO.c ****         return ODR_NO_MAP; /* Object cannot be mapped to the PDO. */
 131:CANopen/301/CO_PDO.c ****     }
 132:CANopen/301/CO_PDO.c **** 
 133:CANopen/301/CO_PDO.c ****     /* Copy values and store mappedLength temporary. */
 134:CANopen/301/CO_PDO.c ****     *OD_IO = OD_IOcopy;
 135:CANopen/301/CO_PDO.c **** #if ((CO_CONFIG_PDO) & (CO_CONFIG_PDO_BITWISE_MAPPING)) != 0
 136:CANopen/301/CO_PDO.c ****     OD_IO->stream.dataOffset = mappedLengthBits;
 137:CANopen/301/CO_PDO.c **** #else
 138:CANopen/301/CO_PDO.c ****     OD_IO->stream.dataOffset = mappedLength;
 139:CANopen/301/CO_PDO.c **** #endif
 140:CANopen/301/CO_PDO.c **** 
 141:CANopen/301/CO_PDO.c ****     /* get TPDO request flag byte from extension */
 142:CANopen/301/CO_PDO.c **** #if OD_FLAGS_PDO_SIZE > 0
 143:CANopen/301/CO_PDO.c ****     if (!isRPDO) {
 144:CANopen/301/CO_PDO.c ****         if ((subIndex < (OD_FLAGS_PDO_SIZE * 8U)) && (entry->extension != NULL)) {
 145:CANopen/301/CO_PDO.c ****             PDO->flagPDObyte[mapIndex] = &entry->extension->flagsPDO[subIndex >> 3];
 146:CANopen/301/CO_PDO.c ****             PDO->flagPDObitmask[mapIndex] = 1U << (subIndex & 0x07U);
 147:CANopen/301/CO_PDO.c ****         } else {
 148:CANopen/301/CO_PDO.c ****             PDO->flagPDObyte[mapIndex] = NULL;
 149:CANopen/301/CO_PDO.c ****         }
 150:CANopen/301/CO_PDO.c ****     }
 151:CANopen/301/CO_PDO.c **** #endif
 152:CANopen/301/CO_PDO.c **** 
 153:CANopen/301/CO_PDO.c ****     return ODR_OK;
 154:CANopen/301/CO_PDO.c **** }
 155:CANopen/301/CO_PDO.c **** 
 156:CANopen/301/CO_PDO.c **** /*
 157:CANopen/301/CO_PDO.c ****  * Initialize PDO mapping parameters
 158:CANopen/301/CO_PDO.c ****  *
 159:CANopen/301/CO_PDO.c ****  * @param PDO This object.
 160:CANopen/301/CO_PDO.c ****  * @param OD Object Dictionary.
 161:CANopen/301/CO_PDO.c ****  * @param OD_PDOMapPar OD entry for "PDO mapping parameter".
 162:CANopen/301/CO_PDO.c ****  * @param isRPDO True for RPDO and false for TPDO.
 163:CANopen/301/CO_PDO.c ****  * @param [out] errInfo Additional information in case of error, may be NULL.
 164:CANopen/301/CO_PDO.c ****  * @param [out] erroneousMap Additional information about erroneous map.
 165:CANopen/301/CO_PDO.c ****  *
 166:CANopen/301/CO_PDO.c ****  * @return #CO_ReturnError_t CO_ERROR_NO on success.
 167:CANopen/301/CO_PDO.c ****  */
 168:CANopen/301/CO_PDO.c **** static CO_ReturnError_t
 169:CANopen/301/CO_PDO.c **** PDO_initMapping(CO_PDO_common_t* PDO, OD_t* OD, OD_entry_t* OD_PDOMapPar, bool_t isRPDO, uint32_t* 
 170:CANopen/301/CO_PDO.c ****                 uint32_t* erroneousMap) {
 171:CANopen/301/CO_PDO.c ****     ODR_t odRet;
 172:CANopen/301/CO_PDO.c ****     size_t pdoDataLength = 0;
 173:CANopen/301/CO_PDO.c ****     uint8_t mappedObjectsCount = 0;
 174:CANopen/301/CO_PDO.c **** 
 175:CANopen/301/CO_PDO.c ****     /* number of mapped application objects in PDO */
 176:CANopen/301/CO_PDO.c ****     odRet = OD_get_u8(OD_PDOMapPar, 0, &mappedObjectsCount, true);
 177:CANopen/301/CO_PDO.c ****     if (odRet != ODR_OK) {
 178:CANopen/301/CO_PDO.c ****         if (errInfo != NULL) {
 179:CANopen/301/CO_PDO.c ****             *errInfo = ((uint32_t)OD_getIndex(OD_PDOMapPar)) << 8;
 180:CANopen/301/CO_PDO.c ****         }
 181:CANopen/301/CO_PDO.c ****         return CO_ERROR_OD_PARAMETERS;
 182:CANopen/301/CO_PDO.c ****     }
 183:CANopen/301/CO_PDO.c **** 
 184:CANopen/301/CO_PDO.c ****     for (uint8_t i = 0; i < CO_PDO_MAX_MAPPED_ENTRIES; i++) {
 185:CANopen/301/CO_PDO.c ****         OD_IO_t* OD_IO = &PDO->OD_IO[i];
