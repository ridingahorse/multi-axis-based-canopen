 477:CANopen/301/CO_PDO.c **** #if ((CO_CONFIG_PDO)&CO_CONFIG_PDO_BITWISE_MAPPING) != 0
 478:CANopen/301/CO_PDO.c ****             if (DLC == (PDO->dataLength + 7) / 8) {
 479:CANopen/301/CO_PDO.c **** #else
 480:CANopen/301/CO_PDO.c ****             if (DLC == PDO->dataLength) {
 481:CANopen/301/CO_PDO.c **** #endif
