 472:CANopen/301/CO_PDO.c ****         if (DLC >= (PDO->dataLength + 7) / 8) {
 473:CANopen/301/CO_PDO.c **** #else
 474:CANopen/301/CO_PDO.c ****         if (DLC >= PDO->dataLength) {
 475:CANopen/301/CO_PDO.c **** #endif
