 434:CANopen/301/CO_driver.h **** #define CO_CAN_ERRTX_WARNING    0x0001U /**< 0x0001 CAN transmitter warning */
 435:CANopen/301/CO_driver.h **** #define CO_CAN_ERRTX_PASSIVE    0x0002U /**< 0x0002 CAN transmitter passive */
 436:CANopen/301/CO_driver.h **** #define CO_CAN_ERRTX_BUS_OFF    0x0004U /**< 0x0004 CAN transmitter bus off */
 437:CANopen/301/CO_driver.h **** #define CO_CAN_ERRTX_OVERFLOW   0x0008U /**< 0x0008 CAN transmitter overflow */
 438:CANopen/301/CO_driver.h **** #define CO_CAN_ERRTX_PDO_LATE   0x0080U /**< 0x0080 TPDO is outside sync window */
