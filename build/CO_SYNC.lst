 377:CANopen/301/CO_ODinterface.h **** /**
 378:CANopen/301/CO_ODinterface.h ****  * Request TPDO, to which OD variable is mapped
 379:CANopen/301/CO_ODinterface.h ****  *
 380:CANopen/301/CO_ODinterface.h ****  * Function clears the flagPDO bit, which corresponds to OD variable at specific OD index and subin
 381:CANopen/301/CO_ODinterface.h ****  * functionality to work, @ref OD_extension_t must be enabled on OD variable. If OD variable is map
 382:CANopen/301/CO_ODinterface.h ****  * event driven transmission, then TPDO will be transmitted after this function call. If OD variabl
 383:CANopen/301/CO_ODinterface.h ****  * than one TPDO with event driven transmission, only the first matched TPDO will be transmitted.
 384:CANopen/301/CO_ODinterface.h ****  *
 385:CANopen/301/CO_ODinterface.h ****  * TPDO event driven transmission is enabled, if TPDO communication parameter, transmission type is
 386:CANopen/301/CO_ODinterface.h ****  * or 255. For other transmission types (synchronous) flagPDO bit is ignored.
 387:CANopen/301/CO_ODinterface.h ****  *
 388:CANopen/301/CO_ODinterface.h ****  * @param entry Object Dictionary entry.
 389:CANopen/301/CO_ODinterface.h ****  * @param subIndex subIndex of the OD variable.
 390:CANopen/301/CO_ODinterface.h ****  */
 391:CANopen/301/CO_ODinterface.h **** static inline void
 392:CANopen/301/CO_ODinterface.h **** OD_requestTPDO(OD_entry_t* entry, uint8_t subIndex) {
 393:CANopen/301/CO_ODinterface.h **** #if OD_FLAGS_PDO_SIZE > 0
 394:CANopen/301/CO_ODinterface.h ****     if ((entry != NULL) && (entry->extension != NULL) && (subIndex < (OD_FLAGS_PDO_SIZE * 8U))) {
 395:CANopen/301/CO_ODinterface.h ****         /* clear subIndex-th bit */
 396:CANopen/301/CO_ODinterface.h ****         uint8_t mask = ~(1U << (subIndex & 0x07U));
 397:CANopen/301/CO_ODinterface.h ****         entry->extension->flagsPDO[subIndex >> 3] &= mask;
 398:CANopen/301/CO_ODinterface.h ****     }
 399:CANopen/301/CO_ODinterface.h **** #endif
 400:CANopen/301/CO_ODinterface.h **** }
 401:CANopen/301/CO_ODinterface.h **** 
 402:CANopen/301/CO_ODinterface.h **** /**
 403:CANopen/301/CO_ODinterface.h ****  * Check if requested TPDO was transmitted
 404:CANopen/301/CO_ODinterface.h ****  *
 405:CANopen/301/CO_ODinterface.h ****  * @param entry Object Dictionary entry.
 406:CANopen/301/CO_ODinterface.h ****  * @param subIndex subIndex of the OD variable.
 407:CANopen/301/CO_ODinterface.h ****  *
 408:CANopen/301/CO_ODinterface.h ****  * @return Return true if event driven TPDO with mapping to OD variable, indicated by entry and sub
 409:CANopen/301/CO_ODinterface.h ****  * transmitted since last @ref OD_requestTPDO call. If there was no @ref OD_requestTPDO call yet an
 410:CANopen/301/CO_ODinterface.h ****  * transmitted by other event, function also returns true.
 411:CANopen/301/CO_ODinterface.h ****  */
 412:CANopen/301/CO_ODinterface.h **** static inline bool_t
 413:CANopen/301/CO_ODinterface.h **** OD_TPDOtransmitted(OD_entry_t* entry, uint8_t subIndex) {
 414:CANopen/301/CO_ODinterface.h **** #if OD_FLAGS_PDO_SIZE > 0
 415:CANopen/301/CO_ODinterface.h ****     if ((entry != NULL) && (entry->extension != NULL) && (subIndex < (OD_FLAGS_PDO_SIZE * 8U))) {
 416:CANopen/301/CO_ODinterface.h ****         /* return true, if subIndex-th bit is set */
 417:CANopen/301/CO_ODinterface.h ****         uint8_t mask = 1U << (subIndex & 0x07U);
 418:CANopen/301/CO_ODinterface.h ****         if ((entry->extension->flagsPDO[subIndex >> 3] & mask) != 0U) {
 419:CANopen/301/CO_ODinterface.h ****             return true;
 420:CANopen/301/CO_ODinterface.h ****         }
 421:CANopen/301/CO_ODinterface.h ****     }
 422:CANopen/301/CO_ODinterface.h **** #endif
 423:CANopen/301/CO_ODinterface.h ****     return false;
 424:CANopen/301/CO_ODinterface.h **** }
